# Copy to .env and fill in. .env is gitignored — never commit it.

# Your personal Moodle calendar export URL (Moodle → Calendar → Export → "Get calendar URL").
# SECRET: anyone with this URL can read your calendar. Used only by local dev scripts
# (npm run fetch-ics). Do NOT prefix with VITE_ — VITE_* vars are bundled into the public site.
MOODLE_ICAL_URL=
